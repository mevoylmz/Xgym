<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HesapMakinesi.StandartPage"
             Title="Standart">
    <Grid RowDefinitions="2*,*,*,*,*,*" ColumnDefinitions="*,*,*,*" Padding="10">

     
        <Label x:Name="SonucEkran" Grid.Row="0" Grid.ColumnSpan="4" Text="0" 
               FontSize="60" HorizontalTextAlignment="End" VerticalTextAlignment="End" />

      
        <Button Grid.Row="1" Grid.Column="0" Text="CE" Style="{StaticResource IslemStili}" Clicked="Temizle_Clicked" />
        <Button Grid.Row="1" Grid.Column="1" Text="C" Style="{StaticResource IslemStili}" Clicked="Temizle_Clicked" />
        <Button Grid.Row="1" Grid.Column="2" Text="DEL" Style="{StaticResource IslemStili}" Clicked="Sil_Clicked" />
        <Button Grid.Row="1" Grid.Column="3" Text="/" Style="{StaticResource IslemStili}" Clicked="Islem_Clicked" />

      
        <Button Grid.Row="2" Grid.Column="0" Text="7" Style="{StaticResource RakamStili}" Clicked="Rakam_Clicked" />
        <Button Grid.Row="2" Grid.Column="1" Text="8" Style="{StaticResource RakamStili}" Clicked="Rakam_Clicked" />
        <Button Grid.Row="2" Grid.Column="2" Text="9" Style="{StaticResource RakamStili}" Clicked="Rakam_Clicked" />
        <Button Grid.Row="2" Grid.Column="3" Text="*" Style="{StaticResource IslemStili}" Clicked="Islem_Clicked" />

      
        <Button Grid.Row="3" Grid.Column="0" Text="4" Style="{StaticResource RakamStili}" Clicked="Rakam_Clicked" />
        <Button Grid.Row="3" Grid.Column="1" Text="5" Style="{StaticResource RakamStili}" Clicked="Rakam_Clicked" />
        <Button Grid.Row="3" Grid.Column="2" Text="6" Style="{StaticResource RakamStili}" Clicked="Rakam_Clicked" />
        <Button Grid.Row="3" Grid.Column="3" Text="-" Style="{StaticResource IslemStili}" Clicked="Islem_Clicked" />

        
        <Button Grid.Row="4" Grid.Column="0" Text="1" Style="{StaticResource RakamStili}" Clicked="Rakam_Clicked" />
        <Button Grid.Row="4" Grid.Column="1" Text="2" Style="{StaticResource RakamStili}" Clicked="Rakam_Clicked" />
        <Button Grid.Row="4" Grid.Column="2" Text="3" Style="{StaticResource RakamStili}" Clicked="Rakam_Clicked" />
        <Button Grid.Row="4" Grid.Column="3" Text="+" Style="{StaticResource IslemStili}" Clicked="Islem_Clicked" />

        <Button Grid.Row="5" Grid.Column="0" Text="+/-" Style="{StaticResource RakamStili}" Clicked="IsaretDegistir_Clicked" />
        <Button Grid.Row="5" Grid.Column="1" Text="0" Style="{StaticResource RakamStili}" Clicked="Rakam_Clicked" />
        <Button Grid.Row="5" Grid.Column="2" Text="," Style="{StaticResource RakamStili}" Clicked="Rakam_Clicked" />
        <Button Grid.Row="5" Grid.Column="3" Text="=" Style="{StaticResource EsittirStili}" Clicked="Esittir_Clicked" />
    </Grid>
</ContentPage>